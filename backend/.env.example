# CompeteIQ Backend Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit real credentials to version control.

# Application
APP_NAME=CompeteIQ
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Database
# Use SQLite for local development (file: ./competeiq.db)
# Use PostgreSQL for production: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./competeiq.db

# Demo company (MINTY-GPT) integration API key
# The external demo website must send this header: X-Demo-API-Key: <value>
DEMO_COMPANY_API_KEY=change-me-to-a-secure-random-key

# Hindsight integration (optional - leave empty if not configured)
# Hindsight requires a separate API server.
# Server install (Python 3.11-3.14 recommended; 3.15 has onnxruntime issues on Windows):
#   pip install hindsight-api
#   # Windows PowerShell:
#   $env:OPENAI_API_KEY="sk-xxx"          # e.g. Groq or OpenAI key
#   $env:HINDSIGHT_API_LLM_API_KEY=$env:OPENAI_API_KEY
#   hindsight-api                          # runs on http://localhost:8888
# Then configure:
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# BAND AI integration (optional - leave empty if not configured)
# Requires Band account at app.band.ai with registered agents
# SDK base URL. The SDK appends /api/v1 itself, so this is the documented
# REST base https://app.band.ai/api/v1 minus the /api/v1 suffix.
BAND_AI_API_URL=https://app.band.ai
# Optional legacy value. BAND AI authenticates per agent; this is not required.
BAND_AI_API_KEY=

# Per-agent credentials (one set per agent - get from Band web app agent creation dialog).
# These are required; BAND_AI_API_KEY above is optional and unused.
BAND_AGENT_RESEARCH_ID=
BAND_AGENT_RESEARCH_KEY=
BAND_AGENT_PRODUCT_ID=
BAND_AGENT_PRODUCT_KEY=
BAND_AGENT_MARKET_ID=
BAND_AGENT_MARKET_KEY=
BAND_AGENT_FINANCIAL_ID=
BAND_AGENT_FINANCIAL_KEY=
BAND_AGENT_HISTORICAL_ID=
BAND_AGENT_HISTORICAL_KEY=
BAND_AGENT_RISK_ID=
BAND_AGENT_RISK_KEY=
BAND_AGENT_STRATEGY_ID=
BAND_AGENT_STRATEGY_KEY=

# External data collection (optional API keys for public sources)
# Leave empty to use public/no-auth sources only
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
ARXIV_API_URL=https://export.arxiv.org/api/query
